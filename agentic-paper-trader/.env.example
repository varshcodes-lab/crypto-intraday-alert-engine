# PAPER MODE ONLY. No exchange credentials are used or supported in this version.
TRADING_MODE=paper
INITIAL_CASH_USDT=100
SCAN_INTERVAL_SECONDS=60
TIMEFRAME=5m
CANDLE_LIMIT=200
MAX_SYMBOLS=15
MAX_OPEN_POSITIONS=3
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_POSITION_FRACTION=0.25
STOP_LOSS_PCT=0.012
TAKE_PROFIT_PCT=0.024
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
MIN_QUOTE_VOLUME_USDT=5000000
DATABASE_PATH=trader.db
LOG_LEVEL=INFO
